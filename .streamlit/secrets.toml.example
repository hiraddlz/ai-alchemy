# Copy to .streamlit/secrets.toml (git-ignored) for local development,
# or paste into the "Secrets" box of your Streamlit Community Cloud app.
#
# Any OpenAI-compatible API works. Examples:
#   OpenAI      -> LLM_PROVIDER = "openai"
#   Groq        -> LLM_PROVIDER = "groq"
#   OpenRouter  -> LLM_PROVIDER = "openrouter"
#   Gemini      -> LLM_PROVIDER = "gemini"
#   Ollama      -> LLM_PROVIDER = "ollama"   (no key needed)

LLM_PROVIDER = "openai"
LLM_API_KEY = "sk-..."
# LLM_MODEL = "gpt-4o-mini"
# LLM_BASE_URL = "https://api.openai.com/v1"   # only needed for provider = "custom"
