# Copy to .streamlit/secrets.toml (git-ignored) for local development, or paste into the
# "Secrets" box of your Streamlit Community Cloud app.
#
# NOTHING HERE IS REQUIRED. With no key configured the app uses the "Free (no key needed)"
# provider: public endpoints via g4f (DeepSeek, GLM, Qwen, ...), best-effort availability.
#
# A key set here becomes the *shared* model for every visitor: they get a working app with
# no setup, the model is locked to LLM_MODEL, and the DEMO_* caps below protect your quota.
# Visitors can always paste their own key in the sidebar to bypass the caps.
#
# Recommended for a public demo: Google Gemini (free tier: 1500 requests/day, 1M tokens/min,
# vision support). Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER = "gemini"
LLM_API_KEY = "AIza..."
LLM_MODEL = "gemini-2.0-flash"
# LLM_BASE_URL = "https://host/v1"   # only for LLM_PROVIDER = "custom"

# Shared-mode caps (defaults shown). Tune to your provider's free tier.
DEMO_SESSION_LIMIT = 25    # model calls per visitor session
DEMO_RPM = 12              # model calls per minute across all visitors
DEMO_MAX_WORDS = 15000     # largest prompt accepted on the shared key

# Other providers:
#   openai       https://platform.openai.com/api-keys
#   groq         https://console.groq.com/keys       (free, fast; ~6k tokens/min on free tier)
#   openrouter   https://openrouter.ai/keys          (has ":free" models)
#   deepseek     https://platform.deepseek.com/api_keys
#   huggingface  https://huggingface.co/settings/tokens
#   ollama       no key; runs locally
